{
  "name": "@nestjs-transactional/cqrs",
  "version": "1.0.0-alpha.5",
  "description": "@nestjs/cqrs integration for @nestjs-transactional/core — transactional event listeners with phases, handler wrapping, AggregateRoot integration",
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "author": "Igor Golovanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorgolovanov/nestjs-transactional.git",
    "directory": "packages/cqrs"
  },
  "bugs": {
    "url": "https://github.com/igorgolovanov/nestjs-transactional/issues"
  },
  "homepage": "https://github.com/igorgolovanov/nestjs-transactional/tree/main/packages/cqrs#readme",
  "keywords": [
    "nestjs",
    "cqrs",
    "transaction",
    "transactional",
    "spring",
    "event-listener",
    "aggregate-root",
    "after-commit"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist *.tsbuildinfo coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "publish:check": "publint && attw --pack ."
  },
  "peerDependencies": {
    "@nestjs-transactional/core": "workspace:^",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs-transactional/core": "workspace:*",
    "@nestjs-transactional/outbox": "workspace:*",
    "@nestjs-transactional/typeorm": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  }
}
