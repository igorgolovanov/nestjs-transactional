{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,

    // ts-jest compiles the specs through this config, so it needs the
    // jest globals on top of the base list.
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*"]
}
