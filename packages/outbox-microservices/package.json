{
  "name": "@nestjs-transactional/outbox-microservices",
  "version": "1.1.0",
  "description": "Event externalization for @nestjs-transactional/outbox via @nestjs/microservices ClientProxy — Spring Modulith @Externalized parity",
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "author": "Igor Golovanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorgolovanov/nestjs-transactional.git",
    "directory": "packages/outbox-microservices"
  },
  "bugs": {
    "url": "https://github.com/igorgolovanov/nestjs-transactional/issues"
  },
  "homepage": "https://github.com/igorgolovanov/nestjs-transactional/tree/main/packages/outbox-microservices#readme",
  "keywords": [
    "nestjs",
    "microservices",
    "outbox",
    "event-publication-registry",
    "event-externalization",
    "spring-modulith",
    "kafka",
    "rabbitmq",
    "nats"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist *.tsbuildinfo coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js",
    "test:cov": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "publish:check": "publint && attw --pack ."
  },
  "peerDependencies": {
    "@nestjs-transactional/outbox": "workspace:^",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/microservices": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs-transactional/core": "workspace:*",
    "@nestjs-transactional/outbox": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/testing": "^11.2.3",
    "@testcontainers/kafka": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "amqplib": "^2.0.1",
    "jest": "^30.4.2",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
