{
  "name": "@nestjs-transactional/outbox",
  "version": "1.1.0",
  "description": "Persistent Event Publication Registry for @nestjs-transactional — Spring Modulith equivalent (ORM-agnostic core)",
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "author": "Igor Golovanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorgolovanov/nestjs-transactional.git",
    "directory": "packages/outbox"
  },
  "bugs": {
    "url": "https://github.com/igorgolovanov/nestjs-transactional/issues"
  },
  "homepage": "https://github.com/igorgolovanov/nestjs-transactional/tree/main/packages/outbox#readme",
  "keywords": [
    "nestjs",
    "outbox",
    "event-publication-registry",
    "spring-modulith",
    "transactional-outbox",
    "transaction"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist *.tsbuildinfo coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "api:check": "api-extractor run && api-extractor run -c api-extractor.testing.json",
    "api:update": "api-extractor run --local && api-extractor run --local -c api-extractor.testing.json",
    "publish:check": "publint && attw --pack ."
  },
  "peerDependencies": {
    "@nestjs-transactional/core": "workspace:^",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs-transactional/core": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "jest": "^30.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
