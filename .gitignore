# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
*.tsbuildinfo
coverage/
.nyc_output/

# api-extractor scratch output. The committed baseline lives in
# packages/*/etc/*.api.md and must stay tracked — temp/ holds the
# freshly-generated report the tool diffs that baseline against.
temp/

# Test artifacts
junit.xml
test-results/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# AI agent state (Claude Code etc.) — local-only, never tracked
.claude/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Changesets state
# (Keep .changeset/config.json and *.md entries — only ignore generated)
.changeset/.pre.json

# Misc
.cache/
