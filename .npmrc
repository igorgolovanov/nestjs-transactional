# Every dependency a workspace project imports must be declared by that
# project. Both of pnpm's hoists are off so that an undeclared import
# fails at resolution instead of silently finding a copy someone else
# pulled in.
#
# Turning off `public-hoist-pattern` alone is not enough: pnpm keeps a
# second, hidden hoist under `node_modules/.pnpm/node_modules`, and
# Jest's resolver reaches it even where Node's does not. Both have to be
# off for the guarantee to hold.
#
# Verified by mutation: with these two lines, dropping `typeorm` from
# `packages/cqrs` while its spec still imports it fails with
# `Cannot find module 'typeorm'`. With either hoist enabled, the same
# spec passes.
hoist-pattern[]=

# A peer range that cannot be satisfied is an error, not a warning.
# Two of this repository's dependency incidents were peer mismatches
# that shipped as warnings nobody read: `eslint-plugin-import` capped at
# ESLint 9 while the workspace moved to 10, and `ioredis` 6 against
# TypeORM's `^5.0.4`, which split the graph into two `DataSource`
# classes and broke DI at runtime. Both fail the install now.
strict-peer-dependencies=true

# Optional peers are still materialised automatically. Combined with the
# line above, missing peers get installed and incompatible ones are
# rejected.
auto-install-peers=true

link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling
