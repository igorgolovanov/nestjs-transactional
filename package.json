{
  "name": "nestjs-transactional-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Declarative transaction management for NestJS",
  "license": "MIT",
  "author": "Igor Golovanov",
  "repository": {
    "type": "git",
    "url": "https://github.com/igorgolovanov/nestjs-transactional.git"
  },
  "bugs": {
    "url": "https://github.com/igorgolovanov/nestjs-transactional/issues"
  },
  "homepage": "https://github.com/igorgolovanov/nestjs-transactional#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "clean": "pnpm -r --filter './packages/*' clean && rm -rf node_modules",
    "test": "pnpm -r --filter './packages/*' test",
    "test:watch": "pnpm -r --filter './packages/*' --parallel test:watch",
    "test:integration": "pnpm -r --filter './packages/*' test:integration",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "lint:doc-links": "./scripts/check-doc-links.sh",
    "lint:test-races": "node ./scripts/check-test-races.js",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" --fix",
    "format": "prettier --write \"packages/*/{src,test}/**/*.{ts,json}\" \"*.{md,json,yml,yaml,mjs}\"",
    "format:check": "prettier --check \"packages/*/{src,test}/**/*.{ts,json}\" \"*.{md,json,yml,yaml,mjs}\"",
    "typecheck": "tsc --build --force",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "release": "changeset publish",
    "prepare": "husky || true",
    "api:check": "pnpm -r --filter './packages/*' api:check",
    "api:update": "pnpm -r --filter './packages/*' api:update",
    "publish:check": "pnpm -r --filter './packages/*' publish:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "packages/*/{src,test}/**/*.{ts,json}": [
      "prettier --write"
    ],
    "{package.json,pnpm-workspace.yaml}": [
      "prettier --write"
    ]
  }
}
