{
  "name": "@nestjs-transactional-examples/e-commerce-orders",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Production-realism flagship: 3 bounded contexts × 3 DataSources × outbox per DS × Kafka externalization × CQRS × REST",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "start": "tsc && node dist/main.js",
