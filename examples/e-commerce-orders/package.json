    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs-transactional/core": "workspace:*",
    "@nestjs-transactional/cqrs": "workspace:*",
    "@nestjs-transactional/outbox": "workspace:*",
    "@nestjs-transactional/typeorm": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/outbox": "~0.1.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.2",
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
