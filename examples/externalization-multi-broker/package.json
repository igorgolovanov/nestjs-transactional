{
  "name": "@nestjs-transactional-examples/externalization-multi-broker",
  "version": "0.0.0",
  "private": true,
  "description": "Outbox externalization to Kafka + RabbitMQ + Redis via @nestjs/microservices — single DataSource, per-event @Externalized({ client }) routing",
