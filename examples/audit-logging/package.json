    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
