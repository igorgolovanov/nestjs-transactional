    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/outbox": "~0.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "joi": "^18.2.9",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.2",
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
