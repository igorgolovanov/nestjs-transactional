    "@nestjs/cqrs": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/testing": "^12.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
