{
  "name": "@nestjs-transactional-examples/externalization-with-fallback",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "What a COMPLETED outbox publication does and does not prove, plus consumer-side inbox dedup and FailedEventPublications.resubmit recovery",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "start": "tsc && node dist/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs"
  },
  "dependencies": {
    "@nestjs-transactional/core": "workspace:*",
    "@nestjs-transactional/outbox": "workspace:*",
    "@nestjs-transactional/outbox-microservices": "workspace:*",
    "@nestjs-transactional/outbox-typeorm": "workspace:*",
    "@nestjs-transactional/typeorm": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/typeorm": "^11.0.3",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.2",
    "@nestjs/testing": "^11.2.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "jest": "^30.4.2",
    "rimraf": "^6.0.1",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
